#!/bin/sh
# geek_bot 分支模型与发布 tag 守卫（pre-push）。
#
# 每次 push 前强制两条硬不变量与来源规则：
#   I1 stage 必须包含 main（git merge-base --is-ancestor origin/main origin/stage 为真）
#   I2 main 不得领先 stage（写入 main 的提交必须已经存在于 stage）
#   *  推 refs/heads/main  ：被推的 main tip 必须已经在 stage 里（main 只做 stage 的快进）
#   *  推 refs/heads/stage ：只能来自 stage 自身或 task/<issue>/<slug> 分支，且必须已包含 origin/main
#   *  删除远端 main/stage：一律拒绝；首次推送的新分支（远端 SHA 全 0）照常判定命名
#   *  推发布 tag（发版只靠打 tag，见 docs/conventions/RELEASES.md）：
#        vX.Y.Z-rc.N 必须打在 stage（本地 stage 或 origin/stage）的提交上 → 否则拒绝
#        vX.Y.Z      必须打在 main（本地 main 或 origin/main）的提交上 → 否则拒绝；
#                    同一提交本地没有 vX.Y.Z-rc.N 只告警，以 release.yml 对同一提交 rc 镜像的核对为准（计划中，#7）
#        X.Y.Z 必须等于该提交 package.json 的 version；格式不对的 v 开头 tag 一律拒绝
#        删除或移动（force）发布 tag 一律拒绝；其它 tag 只告警，不参与发版
#   本钩子只做推送前的本地拦截，不会替你创建 tag，也不代表发版已获授权。
#
# 启用方式（每台克隆各做一次，写入本仓库的 .git/config，不影响其它仓库）：
#   git config core.hooksPath .githooks
# 停用：git config --unset core.hooksPath
# 临时跳过单次检查：git push --no-verify。CI 只对 main/stage 的推送重新判定分支不变量（branch-guard）；
# release.yml（#7）加入之前，发布 tag 没有任何远端复核，本钩子是唯一的机器防线：推 tag 不要加 --no-verify。
# 找不到校验脚本或 node 时，本钩子放行分支推送（main/stage 的推送 CI 仍会判定），但拒绝推 v 开头的 tag。
#
# 本钩子只读本地 Git 证据，不 fetch、不改 refs、不联网。git 自己会把
# 「<local ref> <local sha> <remote ref> <remote sha>」逐行写到本脚本的 stdin。

set -eu

repo_root=$(git rev-parse --show-toplevel)
script="$repo_root/scripts/check-branch-invariants.mjs"

# 没法运行校验脚本时调用：分支推送放行（main/stage 的推送 CI 仍会判定），
# 推 v 开头的 tag 一律拒绝（发布 tag 没有远端复核，release.yml 随 #7 加入）。
skip_guard() {
  reason=$1
  release_tag=""
  while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/tags/v[0-9]*) release_tag=$remote_ref ;;
    esac
  done
  if [ -n "$release_tag" ]; then
    echo "pre-push: ${reason}；这次推送包含 v 开头的 tag（${release_tag}），发布 tag 没有远端复核，拒绝推送。" >&2
    echo "  先让本地守卫能运行（装好 node、确认 scripts/check-branch-invariants.mjs 存在），再推 tag。" >&2
    exit 1
  fi
  echo "pre-push: ${reason}；跳过本地分支守卫（main/stage 的推送 CI 仍会判定；发布 tag 除外，推 tag 时本钩子会拒绝）。" >&2
  exit 0
}

if [ ! -f "$script" ]; then
  skip_guard "找不到 ${script}"
fi

node_bin=${NODE:-node}
if ! command -v "$node_bin" >/dev/null 2>&1; then
  skip_guard "找不到 node"
fi

# 不吞掉 stdin：把它原样交给校验脚本，由脚本逐行解析。
if "$node_bin" "$script" --push --repo "$repo_root"; then
  exit 0
fi

echo "" >&2
echo "pre-push: 分支或发布 tag 规则未通过，推送已被本地钩子拒绝。" >&2
echo "  启用/停用方式：git config core.hooksPath .githooks / git config --unset core.hooksPath" >&2
echo "  提交前请先读 docs/conventions/BRANCHING.md 的分支模型与 docs/conventions/RELEASES.md 的发布 tag 规则。" >&2
exit 1
