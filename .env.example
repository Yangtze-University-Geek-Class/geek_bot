# geek_bot 本机开发用的环境变量样例（只用于本机开发，部署模板是 deploy/env/.env.<环境>，随 #7 加入）。
# 字段来源是 control/platform/config.ts 与 node/worker-config.ts；值只放占位符或通用默认值。
# 用法：复制成 .env.local 后按需修改（pnpm dev:control 启动时会读它，留空的项不覆盖默认值）；
# .env 与 .env.* 已被 .gitignore 忽略，真实值不要提交。
# 密钥一律不写值：用 *_FILE 指向仓库外的密钥文件，或者留空。pnpm check:secrets 会检查本文件。

# control（#3）：实例角色必须显式配置（preview 或 production）；默认只绑回环地址。
# 库、加密备份（backups/）和运维本地通道（run/）都放在库文件所在的目录里；./data/ 已被忽略。
GEEK_BOT_INSTANCE_ROLE=preview
GEEK_BOT_HOST=127.0.0.1
GEEK_BOT_PORT=8080
GEEK_BOT_PUBLIC_ORIGIN=http://localhost:8080
GEEK_BOT_DB_PATH=./data/geek-bot.db
GEEK_BOT_LOG_LEVEL=
GEEK_BOT_APP_VERSION=

# control 的三把独立密钥：master、backup、session 各是 32 字节的 base64，不能共用或互相派生。
# 留空时 pnpm dev:control 在 ./data/dev-secrets/ 生成本机用的一次性密钥。
GEEK_BOT_MASTER_KEY_FILE=
GEEK_BOT_BACKUP_KEY_FILE=
GEEK_BOT_SESSION_SECRET_FILE=

# 产品默认值（见 app/control/src/config.ts）：留空即用默认值。
GEEK_BOT_POLL_INTERVAL_SECONDS=
GEEK_BOT_QUIET_WINDOW_SECONDS=
GEEK_BOT_REMIND_AFTER_DAYS=
GEEK_BOT_CLOSE_AFTER_DAYS=
GEEK_BOT_MAX_FOLLOWUP_ROUNDS=
GEEK_BOT_VM_VCPUS=
GEEK_BOT_VM_MEMORY_MIB=
GEEK_BOT_BACKUP_KEEP_DAILY=
GEEK_BOT_BACKUP_KEEP_WEEKLY=
GEEK_BOT_BACKUP_HOUR_UTC=

# 后台管理员身份沿用 GitHub device flow；代码渠道账号在后台独立绑定。client id 不是密钥。
GEEK_BOT_GITHUB_CLIENT_ID=
GEEK_BOT_OAUTH_CLIENT_SECRET_FILE=
GEEK_BOT_GITHUB_WEB_URL=https://github.com
GEEK_BOT_GITHUB_API_URL=https://api.github.com

# 模型目录只读文件；网关密钥只给 control，不能下发机器或 runner。
GEEK_BOT_MODEL_GATEWAY_URL=https://gateway.example.com/v1
GEEK_BOT_MODEL_GATEWAY_KEY_FILE=
GEEK_BOT_MODEL_CATALOG_FILE=
GEEK_BOT_TASK_TOKEN_BUDGET=
GEEK_BOT_TASK_REQUEST_BUDGET=
GEEK_BOT_TASK_TIMEOUT_SECONDS=

# 全局上限。项目新发现时写入模式 off；preview 清单为空时不能写任何代码项目，包括演练。
GEEK_BOT_WRITE_MODE=dry_run
GEEK_BOT_PUBLISHER_REPO_ALLOWLIST=
GEEK_BOT_PUBLISHER_REPO_DENYLIST=
GEEK_BOT_LEASE_LOST_AFTER_SECONDS=
GEEK_BOT_INFRA_RETRY_MAX=

# 真实后台产物由 control 同源托管；留空使用 app/console/dist，不把 sample 构建用于实际运行。
GEEK_BOT_CONSOLE_DIST=
GEEK_BOT_RELEASE_DISPLAY=
GEEK_BOT_RELEASE_VERSION=
GEEK_BOT_RELEASE_COMMIT=

# 本机节点。后台登记机器后把一次性 node_token 存进独立文件，不能在环境变量里直接写值。
GEEK_BOT_NODE_CONTROL_URL=http://localhost:8080
GEEK_BOT_NODE_NAME=
GEEK_BOT_NODE_TOKEN_FILE=
GEEK_BOT_NODE_SANDBOX_SLOTS=
GEEK_BOT_NODE_VM_SLOTS=
GEEK_BOT_NODE_TAGS=
GEEK_BOT_NODE_CPU=
GEEK_BOT_NODE_MEMORY_MIB=
GEEK_BOT_NODE_DATA_DIR=/tmp/geek-bot-node-local
GEEK_BOT_NODE_SLOTS_DIR=
GEEK_BOT_NODE_OMP_VERSION=
GEEK_BOT_NODE_SPOOL_MAX_MIB=
GEEK_BOT_NODE_HEARTBEAT_SECONDS=
GEEK_BOT_NODE_QEMU=
GEEK_BOT_NODE_QEMU_IMG=
GEEK_BOT_NODE_NETCAT=
GEEK_BOT_NODE_VM_BASE_IMAGE=
GEEK_BOT_NODE_VM_TOOLS_IMAGE=
GEEK_BOT_NODE_VM_SEED_ISO=
GEEK_BOT_NODE_VM_DISK_GIB=
GEEK_BOT_NODE_EGRESS_ALLOW=
GEEK_BOT_NODE_EGRESS_DENY_CIDRS=
GEEK_BOT_NODE_EGRESS_MAX_CONNECTIONS=
GEEK_BOT_NODE_EGRESS_MAX_BYTES=
