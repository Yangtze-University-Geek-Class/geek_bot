# geek_bot 本机开发用的环境变量样例（只用于本机开发，部署模板是 deploy/env/.env.<环境>，随 #7 加入）。
# 字段随 #3、#5、#13 定稿：这里只列确定会用到的几项，值全部是占位符或通用默认值。
# 用法：复制成 .env.local 后按需修改（pnpm dev:control 启动时会读它，留空的项不覆盖默认值）；
# .env 与 .env.* 已被 .gitignore 忽略，真实值不要提交。
# 密钥一律不写值：用 *_FILE 指向仓库外的密钥文件，或者留空。pnpm check:secrets 会检查本文件。

# control（#3）：实例角色必须显式配置（preview 或 production）；默认只绑回环地址。
# 库、加密备份（backups/）和运维本地通道（run/）都放在库文件所在的目录里；./data/ 已被忽略。
GEEK_BOT_INSTANCE_ROLE=preview
GEEK_BOT_HOST=127.0.0.1
GEEK_BOT_PORT=8080
GEEK_BOT_PUBLIC_ORIGIN=http://localhost:8080
GEEK_BOT_DB_PATH=./data/geek-bot.db
GEEK_BOT_LOG_LEVEL=
GEEK_BOT_APP_VERSION=

# control 的密钥文件（#3）：每个文件放一把 32 字节密钥的 base64（例如 openssl rand -base64 32 的输出），两把必须不同。
# 留空时 pnpm dev:control 在 ./data/dev-secrets/ 生成本机用的一次性密钥。
GEEK_BOT_MASTER_KEY_FILE=
GEEK_BOT_BACKUP_KEY_FILE=

# 产品默认值（见 app/control/src/config.ts）：留空即用默认值。
GEEK_BOT_POLL_INTERVAL_SECONDS=
GEEK_BOT_QUIET_WINDOW_SECONDS=
GEEK_BOT_REMIND_AFTER_DAYS=
GEEK_BOT_CLOSE_AFTER_DAYS=
GEEK_BOT_MAX_FOLLOWUP_ROUNDS=
GEEK_BOT_VM_VCPUS=
GEEK_BOT_VM_MEMORY_MIB=
GEEK_BOT_BACKUP_KEEP_DAILY=
GEEK_BOT_BACKUP_KEEP_WEEKLY=
GEEK_BOT_BACKUP_HOUR_UTC=

# GitHub 登录（#5）。client id 不是密钥；client secret 只能以文件提供。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET_FILE=

# 模型网关（#13）。地址写占位，网关密钥只能以文件提供，且只给 control。
MODEL_GATEWAY_BASE_URL=https://gateway.example.com/v1
MODEL_GATEWAY_API_KEY_FILE=
