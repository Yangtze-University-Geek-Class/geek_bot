# geek_bot 本机开发用的环境变量样例（只用于本机开发，部署模板是 deploy/env/.env.<环境>，随 #7 加入）。
# 字段随 #3、#5、#13 定稿：这里只列确定会用到的几项，值全部是占位符或通用默认值。
# 用法：复制成 .env.local 后按需修改；.env 与 .env.* 已被 .gitignore 忽略，真实值不要提交。
# 密钥一律不写值：用 *_FILE 指向仓库外的密钥文件，或者留空。pnpm check:secrets 会检查本文件。

# control 的对外地址与数据库路径（#3）。/data/ 已被忽略。
GEEK_BOT_PUBLIC_ORIGIN=http://localhost:8080
GEEK_BOT_DB_PATH=./data/geek-bot.db

# 产品默认值（见 app/control/src/config.ts）：留空即用默认值。
GEEK_BOT_POLL_INTERVAL_SECONDS=
GEEK_BOT_QUIET_WINDOW_SECONDS=
GEEK_BOT_REMIND_AFTER_DAYS=
GEEK_BOT_CLOSE_AFTER_DAYS=
GEEK_BOT_MAX_FOLLOWUP_ROUNDS=
GEEK_BOT_VM_VCPUS=
GEEK_BOT_VM_MEMORY_MIB=

# GitHub 登录与令牌加密（#5）。client id 不是密钥；master key 只能以文件提供。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET_FILE=
GEEK_BOT_MASTER_KEY_FILE=

# 模型网关（#13）。地址写占位，网关密钥只能以文件提供，且只给 control。
MODEL_GATEWAY_BASE_URL=https://gateway.example.com/v1
MODEL_GATEWAY_API_KEY_FILE=
